{
  "name": "ambient",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "predev": "fuser -k 1420/tcp 2>/dev/null; lsof -ti tcp:1420 2>/dev/null | xargs -r kill 2>/dev/null; true",
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "RUSTC_WRAPPER='' CARGO_INCREMENTAL=0 tauri",
    "tauri:dev": "RUSTC_WRAPPER='' CARGO_INCREMENTAL=0 tauri dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "gen:shaders": "bun run scripts/gen-shaders.ts",
    "check:shaders": "bun run scripts/gen-shaders.ts --check",
    "gen:font": "bun run scripts/gen-matrix-font.ts",
    "check:font": "bun run scripts/gen-matrix-font.ts --check",
    "gen:types": "cd src-tauri && RUSTC_WRAPPER= cargo test -p ambient-core export_bindings",
    "test": "vitest run",
    "release": "./scripts/release.sh",
    "release:publish": "bash scripts/publish.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
