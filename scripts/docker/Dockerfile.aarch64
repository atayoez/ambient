# Linux aarch64 build environment for Ambient.
#
# Used by scripts/build-linux-arm64.sh to produce the aarch64 AppImage
# locally via QEMU on an x86_64 host (binfmt_misc qemu-aarch64 must be
# registered — `update-binfmts --enable` or via systemd-binfmt). First
# image build is slow (apt + rust install in an emulated VM); each
# subsequent build is fast because the layer cache + mounted cargo /
# tauri caches survive.
#
# Manual build:
#   docker build --platform linux/arm64 -t ambient-build-aarch64:latest \
#     -f scripts/docker/Dockerfile.aarch64 scripts/docker
#
# Or let build-linux-arm64.sh do it automatically on first run.

FROM --platform=linux/arm64 ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Tauri Linux runtime + build deps (mirrors the CI ubuntu jobs).
# `file` is needed by some appimage helpers; build-essential gives us
# gcc/make/etc for cargo's C-dep crates (rustls, ring).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates curl git unzip wget \
      build-essential pkg-config libssl-dev file \
      libwebkit2gtk-4.1-dev libgtk-3-dev \
      libayatana-appindicator3-dev librsvg2-dev \
      patchelf && \
    rm -rf /var/lib/apt/lists/*

# Rust toolchain — minimal profile keeps the image smaller; we don't
# need docs / rustfmt / clippy inside the build container.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
      sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path

# Bun for the JS side.
RUN curl -fsSL https://bun.sh/install | bash

ENV PATH="/root/.cargo/bin:/root/.bun/bin:${PATH}"

WORKDIR /work
CMD ["bash"]
