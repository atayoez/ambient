{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ambient",
  "version": "0.3.0",
  "identifier": "com.ambient.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://ambient.oezcan.me/downloads/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDRDg0QTQ3NTc2RDZDQzcKUldUSGJHMVhSMHJZdk96Y3p0dnRxS2xwU1cvWFZWNU5yOWZ3K1pueEpDWlpmZFJtV1I1STNEaS8K"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ambient",
        "width": 820,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$HOME/.local/share/com.ambient.app/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "dmg",
      "msi"
    ],
    "category": "Utility",
    "shortDescription": "Wallpaper generator with patterns, emoji, and AI",
    "longDescription": "Linux wallpaper generator. Create dynamic patterns with colors and emoji, pull from curated sources (NASA APOD, Unsplash, Pexels), or generate via AI — all rendered at your exact screen resolution.",
    "publisher": "Ambient",
    "copyright": "© 2026 Ambient contributors",
    "homepage": "https://github.com/atayozcan/ambient",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "wix": {
        "language": ["en-US"]
      }
    }
  }
}
