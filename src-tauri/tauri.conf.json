{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ambient",
  "version": "1.0.1",
  "identifier": "me.oezcan.ambient",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://ambient.oezcan.me/downloads/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDRDg0QTQ3NTc2RDZDQzcKUldUSGJHMVhSMHJZdk96Y3p0dnRxS2xwU1cvWFZWNU5yOWZ3K1pueEpDWlpmZFJtV1I1STNEaS8K"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ambient",
        "width": 820,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1421 http://localhost:1420; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$HOME/.local/share/me.oezcan.ambient/**",
          "$PICTURE/Ambient/**",
          "$HOME/.local/share/wallpapers/Ambient/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "deb",
      "rpm",
      "dmg",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "category": "GraphicsAndDesign",
    "shortDescription": "Wallpaper studio with patterns, emoji, sources, and AI",
    "longDescription": "Cross-platform wallpaper studio. Create dynamic patterns with colors and emoji, pull from curated sources (NASA APOD, Unsplash, Pexels), or generate via AI — all rendered at your exact screen resolution.",
    "publisher": "Atay Özcan",
    "copyright": "© 2026 Atay Özcan. All rights reserved.",
    "homepage": "https://ambient.oezcan.me",
    "license": "Proprietary",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": [
          "en-US"
        ]
      }
    }
  }
}
